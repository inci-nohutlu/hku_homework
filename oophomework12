using System;

enum FuelType { Petrol, Diesel, Electric }

class Vehicle
{
    public string Brand { get; set; }
    public string Model { get; set; }
    public int Year { get; set; }
    public FuelType Fuel { get; set; }

    public static int Count = 0;

    public Vehicle(string brand, string model, int year, FuelType fuel)
    {
        Brand = brand;
        Model = model;
        Year = year;
        Fuel = fuel;
        Count++;
    }

    public virtual void StartEngine()
    {
        Console.WriteLine("The vehicle engine is starting...");
    }

    public string Info()
    {
        return $"{Brand} {Model} ({Year}, {Fuel})";
    }
}

class Car : Vehicle
{
    public Car(string brand, string model, int year, FuelType fuel)
        : base(brand, model, year, fuel)
    {
    }

    public override void StartEngine()
    {
        Console.WriteLine("Car engine started.");
    }
}

class Truck : Vehicle
{
    public Truck(string brand, string model, int year, FuelType fuel)
        : base(brand, model, year, fuel)
    {
    }

    public override void StartEngine()
    {
        Console.WriteLine("Truck engine started.");
    }
}

class Motorcycle : Vehicle
{
    public Motorcycle(string brand, string model, int year, FuelType fuel)
        : base(brand, model, year, fuel)
    {
    }

    public override void StartEngine()
    {
        Console.WriteLine("Motorcycle engine started.");
    }
}

class Program
{
    static void Main()
    {
        Vehicle[] fleet =
        {
            new Car("Togg", "T10X", 2024, FuelType.Electric),
            new Truck("Ford", "F-Max", 2022, FuelType.Diesel),
            new Motorcycle("Yamaha", "R25", 2023, FuelType.Petrol)
        };

        foreach (Vehicle vehicle in fleet)
        {
            Console.WriteLine(vehicle.Info());
            vehicle.StartEngine();
            Console.WriteLine();
        }

        Console.WriteLine("Total vehicles: " + Vehicle.Count);
    }
}
