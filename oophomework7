using System;
using System.Windows.Forms;

namespace HesapMakinesi
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        
        private double EnBuyukSayi(double s1, double s2) => Math.Max(s1, s2);
        private double UsAl(double taban, double us) => Math.Pow(taban, us);

        private bool AsalMi(int sayi)
        {
            if (sayi < 2) return false;
            for (int i = 2; i <= Math.Sqrt(sayi); i++)
            {
                if (sayi % i == 0) return false;
            }
            return true;
        }

        private long Faktoriyel(int sayi)
        {
            long sonuc = 1;
            for (int i = 1; i <= sayi; i++)
            {
                sonuc *= i;
            }
            return sonuc;
        }

      

        
        private void btnMx_Click(object sender, EventArgs e) => HesaplaMax();
        private void btnMax_Click(object sender, EventArgs e) => HesaplaMax();
        private void btnMax_Click_1(object sender, EventArgs e) => HesaplaMax();

       
        private void btnPower_Click(object sender, EventArgs e) => HesaplaPower();
        private void btnPower_Click_1(object sender, EventArgs e) => HesaplaPower();

        
        private void btnIsPrime_Click(object sender, EventArgs e) => HesaplaIsPrime();
        private void btnIsPrime_Click_1(object sender, EventArgs e) => HesaplaIsPrime();

        
        private void btnFactorial_Click(object sender, EventArgs e) => HesaplaFactorial();
        private void btnFactorial_Click_1(object sender, EventArgs e) => HesaplaFactorial();

        
        private void label1_Click(object sender, EventArgs e) { }
        private void Form1_Load(object sender, EventArgs e) { }

        

        private void HesaplaMax()
        {
            if (double.TryParse(txtSayi1.Text, out double s1) && double.TryParse(txtSayi2.Text, out double s2))
                lblSonuc.Text = "Büyük Sayı: " + EnBuyukSayi(s1, s2);
            else
                MessageBox.Show("Lütfen iki kutuya da sayı girin!");
        }

        private void HesaplaPower()
        {
            if (double.TryParse(txtSayi1.Text, out double taban) && double.TryParse(txtSayi2.Text, out double us))
                lblSonuc.Text = $"{taban} ^ {us} = " + UsAl(taban, us);
            else
                MessageBox.Show("Lütfen iki kutuya da sayı girin!");
        }

        private void HesaplaIsPrime()
        {
            if (int.TryParse(txtSayi1.Text, out int sayi))
                lblSonuc.Text = AsalMi(sayi) ? $"{sayi} Asal Sayıdır." : $"{sayi} Asal Değildir.";
            else
                MessageBox.Show("Lütfen ilk kutuya geçerli bir tam sayı girin!");
        }

        private void HesaplaFactorial()
        {
            if (int.TryParse(txtSayi1.Text, out int sayi) && sayi >= 0)
                lblSonuc.Text = $"{sayi}! = " + Faktoriyel(sayi);
            else
                MessageBox.Show("Lütfen ilk kutuya 0 veya daha büyük bir tam sayı girin!");
        }
    }
}
